# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.log
*.swp

# JVM Crash & Diagnostic Dumps
hs_err_pid*
replay_pid*
*.hprof
oom_dump.hprof

# Test Execution & Coverage Reports
test-output/
surefire-reports/
failsafe-reports/
jacoco.exec
target/site/jacoco/

