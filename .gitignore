# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js Build & Prerender Artifacts
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.turbo/
frontend/.turbo/
.npm/

# TypeScript / Linter / Bundle Artifacts
*.tsbuildinfo
next-env.d.ts

# Frontend Environment Variables (Never commit secrets)
.env*.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env*.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Vercel / Cloud Deployment
.vercel/

